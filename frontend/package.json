{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:env": "echo \"self.apiKey = '$VITE_API_KEY'; self.authDomain = '$VITE_AUTH_DOMAIN'; self.projectId = '$VITE_PROJECT_ID'; self.storageBucket = '$VITE_STORAGE_BUCKET'; self.messagingSenderId = '$VITE_MESSAGING_SENDER_ID'; self.appId = '$VITE_APP_ID';\" > public/sw-env.js",
    "build": "tsc -b && npm run build:env && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.2.4",
    "axios": "^1.15.2",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "lucide-react": "0.474.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.2",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
