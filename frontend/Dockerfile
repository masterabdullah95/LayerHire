# Build stage
FROM oven/bun:alpine AS build
WORKDIR /app

# Declare build argument
ARG VITE_API_URL
ARG VITE_APP_URL
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_PRIVATE_KEY
ARG VITE_FIREBASE_CLIENT_EMAIL
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_FIREBASE_SERVICE_ACCOUNT_KEY
ARG VITE_FIREBASE_VAPID

# Make it available to Vite during build
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID
ENV VITE_FIREBASE_PRIVATE_KEY=$VITE_FIREBASE_PRIVATE_KEY
ENV VITE_FIREBASE_CLIENT_EMAIL=$VITE_FIREBASE_CLIENT_EMAIL
ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY
ENV VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN
ENV VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET
ENV VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID
ENV VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID
ENV VITE_FIREBASE_SERVICE_ACCOUNT_KEY=$VITE_FIREBASE_SERVICE_ACCOUNT_KEY
ENV VITE_FIREBASE_VAPID=$VITE_FIREBASE_VAPID

COPY package*.json bun.lock ./

# Install dependencies with bun
RUN bun install --frozen-lockfile

# Copy source code
COPY . .

# Build the application with bun
RUN bun run build

# Production stage - use nginx to serve static files
FROM oven/bun:alpine

WORKDIR /app

COPY --from=build /app/dist ./dist

EXPOSE 5173

CMD ["bunx", "serve", "-s", "dist", "-l", "5173"]